{
  "name": "cheap-labor",
  "version": "0.1.0",
  "description": "Cheap Labor: MCP bridge where ChatGPT thinks/plans/reviews and Codex executes. Free local I/O tools + spawns the official codex mcp-server.",
  "type": "module",
  "license": "MIT",
  "author": "psrisuphan",
  "bin": {
    "cheap-labor": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --import ./tests/setup.ts --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
